{
  "version": 2,
  "builds": [
    {
      "src": "server/vercel_app.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "server/**"
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/vercel_app.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "server/vercel_app.py": {
      "maxDuration": 300
    }
  }
}